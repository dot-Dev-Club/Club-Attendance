# Backend Environment Variables
# Copy this file to .env and fill in the values

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///./club_attendance.db

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Google Sheets Integration
# Path to the Google service account JSON file (preferred)
GOOGLE_SERVICE_ACCOUNT_FILE=

# OR use OAuth2 flow
GOOGLE_OAUTH_CLIENT_SECRETS=./client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=./oauth_token.json

# Google Spreadsheet settings
GOOGLE_SPREADSHEET_ID=
GOOGLE_SPREADSHEET_TITLE=

# OAuth redirect URI
OAUTH_REDIRECT_URI=http://localhost:8000/sheets/oauth/callback
